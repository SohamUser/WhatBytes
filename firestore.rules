rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      function signedIn() {
        return request.auth != null;
      }

      function ownsExistingTask() {
        return signedIn() && resource.data.userId == request.auth.uid;
      }

      function ownsIncomingTask() {
        return signedIn() && request.resource.data.userId == request.auth.uid;
      }

      function hasValidShape() {
        return request.resource.data.keys().hasOnly([
          'title', 'description', 'dueDate', 'priority',
          'completed', 'userId', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.dueDate is timestamp
        && request.resource.data.priority in ['low', 'medium', 'high']
        && request.resource.data.completed is bool
        && request.resource.data.userId is string
        && request.resource.data.createdAt is timestamp;
      }

      allow create: if ownsIncomingTask() && hasValidShape();
      allow read, delete: if ownsExistingTask();
      allow update: if ownsExistingTask() && ownsIncomingTask() && hasValidShape();
    }
  }
}
